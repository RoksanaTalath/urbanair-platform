# ═══════════════════════════════════════════════════════════
# UrbanAir Backend — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── MongoDB ──────────────────────────────────────────────────
# Option 1: Local MongoDB (free, no account needed)
MONGODB_URL=mongodb://localhost:27017
#
# Option 2: MongoDB Atlas (cloud, free tier available)
# 1. Go to https://www.mongodb.com/atlas/database
# 2. Create free cluster → Connect → Drivers
# 3. Copy connection string and replace below:
# MONGODB_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB_NAME=urbanair

# ── WAQI API ──────────────────────────────────────────────────
# Get free token: https://aqicn.org/data-platform/token/
# The "demo" token works but has strict rate limits
WAQI_API_TOKEN=demo

# ── Security ──────────────────────────────────────────────────
# Change these in production! Use random 32+ character strings
SECRET_KEY=urbanair-dev-secret-key-change-this-in-production
JWT_SECRET=urbanair-jwt-dev-secret-change-this-in-production

# ── CORS (Frontend URL) ───────────────────────────────────────
# Where your React frontend runs
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Optional Settings ─────────────────────────────────────────
DEBUG=false
JWT_EXPIRE_MINUTES=1440
AQI_CACHE_TTL=300
FORECAST_CACHE_TTL=900

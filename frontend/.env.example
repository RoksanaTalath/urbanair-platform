# UrbanAir Frontend — Environment Variables
# Copy this file to .env

# Backend API URL (where your FastAPI runs)
VITE_API_URL=http://localhost:8000/api/v1

# WAQI API Token
# Get free token: https://aqicn.org/data-platform/token/
# The "demo" token works for testing
VITE_WAQI_TOKEN=demo

# App metadata
VITE_APP_NAME=UrbanAir
VITE_APP_VERSION=2.0.0
